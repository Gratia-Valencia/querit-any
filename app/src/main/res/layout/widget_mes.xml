<?xml version="1.0" encoding="utf-8"?>
<!-- Piloto 126.25 · APK 1.3 · 📅 El calendario del mes (ver QueritWidgetMes.java)
     APK 1.4 · la rejilla ocupa todo el alto que queda y cada semana se reparte lo mismo (antes sobraba hueco abajo) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_fondo"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mes_antes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="6dp"
            android:paddingRight="10dp"
            android:text="◀"
            android:textColor="#e2622c"
            android:textSize="16sp"
            android:contentDescription="Mes anterior" />

        <TextView
            android:id="@+id/mes_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#2b211b"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mes_despues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="6dp"
            android:text="▶"
            android:textColor="#e2622c"
            android:textSize="16sp"
            android:contentDescription="Mes siguiente" />

        <TextView
            android:id="@+id/mes_modo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:text="Aa"
            android:textColor="#e2622c"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="Puntitos o nombres" />
        <TextView
            android:id="@+id/refrescar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:text="↻"
            android:textColor="#e2622c"
            android:textSize="18sp"
            android:contentDescription="Poner al día" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="L" android:textColor="#8a6f5e" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="#8a6f5e" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="X" android:textColor="#8a6f5e" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="J" android:textColor="#8a6f5e" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="V" android:textColor="#8a6f5e" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#8a6f5e" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="D" android:textColor="#8a6f5e" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rejilla"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#2b211b"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>